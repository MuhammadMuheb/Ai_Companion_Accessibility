USER_NAME=YourName
USER_TIMEZONE=local
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text
DATA_DIR=data
LOG_DIR=data/logs
STT_MODEL_SIZE=base
TTS_ENGINE=pyttsx3
LOG_LEVEL=INFO
ENABLE_VOICE=true
ENABLE_ACCESSIBILITY=true
PURE_VOICE_MODE=false

# ---- Nova Cloud (cloud/, set these in Vercel > Settings > Environment Variables) ----
