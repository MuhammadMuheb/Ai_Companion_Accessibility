{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import os,http.server,functools;http.server.ThreadingHTTPServer(('127.0.0.1',int(os.environ.get('PORT','8000'))),functools.partial(http.server.SimpleHTTPRequestHandler,directory='.')).serve_forever()"
      ],
      "port": 8000,
      "autoPort": true
    }
  ]
}